---
import { site, siparisAcik } from '../data/site.js';
interface Props { ad: string; fiyat: string; yakinda?: boolean; }
const { ad, fiyat, yakinda = false } = Astro.props;
const k = site.siparis;
---
<dialog class="siparis" data-siparis aria-labelledby="sp-baslik">
  <div class="sp-ic">
    <div class="sp-ust">
      <h2 id="sp-baslik" class="baslik">{yakinda ? 'Haber ver' : 'Sipariş'}</h2>
      <form method="dialog"><button class="ust sp-kapat" type="submit">Kapat</button></form>
    </div>
    <div class="sp-ozet">
      <img data-sp-img src="" alt="" width="80" height="100" />
      <div>
        <strong>{ad}</strong>
        <span class="soluk" data-sp-yuzey></span>
        <span class="mono">{fiyat}</span>
      </div>
    </div>
    <label class="ust soluk" for="sp-mesaj">Mesajın</label>
    <textarea id="sp-mesaj" rows="4" readonly data-sp-mesaj></textarea>
    <div class="sp-dugmeler">
      {k.whatsapp && <a class="dugme" data-kanal="whatsapp" href="#" target="_blank" rel="noopener">WhatsApp ile gönder</a>}
      {k.instagram && <a class="dugme ikincil" data-kanal="instagram" href="#" target="_blank" rel="noopener">Instagram’dan yaz</a>}
      {k.eposta && <a class="dugme ikincil" data-kanal="eposta" href="#">E-posta gönder</a>}
      <button class={siparisAcik ? 'dugme ikincil' : 'dugme'} type="button" data-kopyala>Mesajı kopyala</button>
    </div>
    <p class="sp-durum mono" aria-live="polite" data-sp-durum></p>
    {!siparisAcik && <p class="sp-not">Sipariş kanalımız çok yakında burada olacak. Şimdilik mesajı kopyalayabilirsin.</p>}
    {k.instagram && <p class="sp-not">Instagram’da mesaj önceden yazılamıyor; düğme mesajı kopyalar, sohbete yapıştırman yeter.</p>}
    <p class="sp-kucuk soluk">
      {yakinda
        ? 'Satışa çıktığında haber veririz.'
        : 'Her parça siparişle dökülür. Teslim süresini ve kargoyu mesajda netleştiririz. Teslimden sonra 14 gün içinde iade edebilirsin; iade kargosu bizden.'}
    </p>
  </div>
</dialog>

<style>
  .siparis {
    width: min(520px, calc(100% - 24px)); max-height: calc(100svh - 24px);
    padding: 0; border: 1px solid var(--cizgi-guclu); color: var(--yazi); background: var(--kutu); border-radius: 22px;
    box-shadow: 0 40px 120px rgb(0 0 0 / .6);
  }
  .siparis[open] { animation: sp-ac .4s var(--yay); }
  .siparis::backdrop { background: rgb(0 0 0 / .66); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .sp-ic { display: grid; gap: 16px; padding: 22px 24px 24px; }
  .sp-ust { display: flex; justify-content: space-between; align-items: center; }
  .sp-ust h2 { font-size: 30px; line-height: 1; }
  .sp-ozet {
    display: grid; grid-template-columns: 80px 1fr; gap: 16px; align-items: center;
    padding-block: 12px; border-block: 1px solid var(--cizgi);
  }
  .sp-ozet img { width: 80px; height: 100px; object-fit: contain; background: var(--havuz); border-radius: 10px; }
  .sp-ozet div { display: grid; gap: 2px; }
  .sp-ozet strong { font-size: 12.5px; font-weight: 640; font-stretch: 125%; letter-spacing: .12em; text-transform: uppercase; }
  textarea {
    width: 100%; resize: none; padding: 12px; border: 1px solid var(--cizgi); background: var(--siyah); border-radius: 12px;
    font: 14px/1.5 var(--sans); color: var(--yazi); margin-top: -8px;
  }
  .sp-dugmeler { display: grid; gap: 8px; }
  .sp-durum:empty { display: none; }
  .sp-not, .sp-kucuk { font-size: 13px; }
  @keyframes sp-ac { from { opacity: 0; transform: translateY(14px) scale(.985); } }
</style>
