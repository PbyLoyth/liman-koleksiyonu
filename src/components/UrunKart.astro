---
// Ürün kartı: dekupe 0° karesi; fareyle üstünde gezince ürün döner. Yüzey değişince (koleksiyon anahtarı)
// kare kökü ve bağlantı birlikte değişir.
import { donusKok, ilkKare, KARE } from '../data/gorseller.js';
import { urunYolu, tl } from '../data/yol.js';
import { kod } from '../data/urunler.js';

interface Props { u: any; yuzey?: string; sizes?: string; }
const { u, yuzey = 'tuz', sizes = '(min-width: 1200px) 25vw, (min-width: 760px) 33vw, 50vw' } = Astro.props;
const kok = donusKok(u.slug, yuzey);
const ilk = ilkKare(kok);
---
<li class="kart">
  <a class="kart-bag" href={urunYolu(u.slug, yuzey)} data-kart data-slug={u.slug}>
    <div
      class="donus kart-gorsel havuz"
      data-donus
      data-mod="gezin"
      data-kok={kok}
      data-kare={KARE}
      style={`view-transition-name: u-${u.slug}`}
    >
      <img
        src={ilk.src}
        srcset={ilk.srcset}
        sizes={sizes}
        width="1000"
        height="1250"
        alt={`${u.ad}, ${u.rol.toLocaleLowerCase('tr-TR')}`}
        loading="lazy"
        decoding="async"
      />
    </div>
    <span class="mono kart-kod">{kod(u)}</span>
    {u.yakinda ? <span class="mono kart-rozet">Yakında</span> : <span class="mono kart-ipucu" aria-hidden="true">360°</span>}
    <div class="kart-alt">
      <h3 class="kart-ad">{u.ad}</h3>
      <p class="mono kart-fiyat">{u.yakinda ? '—' : tl(u.fiyat)}</p>
      <p class="kart-rol">{u.rol}</p>
    </div>
  </a>
</li>

<style>
  .kart { border-right: 1px solid var(--c); border-bottom: 1px solid var(--c); min-width: 0; }
  .kart-bag { position: relative; display: block; height: 100%; }
  .kart-gorsel { width: 100%; }
  .kart-gorsel img { transition: transform .9s var(--hiz); }
  .kart-kod { position: absolute; top: 14px; left: 16px; color: var(--s); }
  .kart-rozet { position: absolute; top: 14px; right: 16px; color: var(--kan); }
  .kart-ipucu {
    position: absolute; top: 14px; right: 16px; color: var(--s);
    opacity: 0; transform: translateY(-3px); transition: opacity .3s, transform .3s var(--hiz);
  }
  .kart-alt {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px;
    padding: 2px 16px 20px;
  }
  .kart-ad {
    font-size: 12.5px; font-weight: 640; font-stretch: 125%; letter-spacing: .13em;
    text-transform: uppercase; line-height: 1.3;
  }
  .kart-fiyat { justify-self: end; font-size: 12px; }
  .kart-rol { grid-column: 1 / -1; color: var(--s); font-size: 13px; margin-top: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .kart-bag:hover .kart-ipucu { opacity: 1; transform: none; }
    .kart-bag:hover .kart-gorsel img { transform: scale(1.025); }
  }
  @media (max-width: 760px) {
    .kart-kod, .kart-rozet { top: 10px; left: 12px; }
    .kart-rozet { left: auto; right: 12px; }
    .kart-alt { padding: 0 12px 16px; }
    .kart-ad { font-size: 11.5px; letter-spacing: .1em; }
    .kart-fiyat { font-size: 11px; }
    .kart-rol { font-size: 12.5px; }
  }
</style>
