---
// Kayan şerit: kapak ile koleksiyon arasında
import Isaret from './Isaret.astro';
const parcalar = ['Elde dökülür', 'Beyaz çimento', 'Katedral', 'Yedi yüzey', 'Siparişle üretim', 'Liman', '14 gün iade'];
---
<div class="kayan koyu" data-ton="koyu" aria-hidden="true">
  <div class="kayan-ic">
    {[0, 1].map(() => (
      <div class="kayan-grup">
        {parcalar.map((p) => (
          <Fragment><span>{p}</span><Isaret /></Fragment>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .kayan { overflow: hidden; border-block: 1px solid var(--cizgi); padding-block: 15px; }
  .kayan-ic { display: flex; width: max-content; animation: kay 52s linear infinite; }
  .kayan-grup { display: flex; align-items: center; gap: 30px; padding-right: 30px; }
  .kayan span {
    font: 600 11.5px/1 var(--sans); font-stretch: 125%; letter-spacing: .22em; text-transform: uppercase;
    white-space: nowrap;
  }
  .kayan :global(.isaret) { width: 9px; height: 9px; color: var(--soluk); }
  @keyframes kay { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .kayan-ic { animation: none; } }
</style>
