---
// Yüzey örneği: küçük daire. renk verilmezse "renk" yüzeyi dört imza rengini gösterir.
interface Props { yuzey: string; renk?: string; }
const { yuzey, renk } = Astro.props;

const BEYAZ = '#E4E1DA';
const KOYU_DERZ = '#3B3A37';
const ACIK_DERZ = '#E2DED6';
const nokta = [
  [10, 12, 1.7], [25, 9, 1.1], [31, 18, 2.3], [15, 24, 1.3], [22, 30, 1.9],
  [8, 28, 1.0], [28, 29, 1.2], [18, 15, 0.9], [33, 26, 0.8], [12, 33, 1.0],
];
const isaret = ['#B5272D', '#1E4A8C', '#E0A21A', '#242424'];
const koyuMu = (h) => {
  const n = parseInt(h.slice(1), 16);
  return 0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255) < 140;
};
const id = `o${Math.random().toString(36).slice(2, 8)}`;
const zemin = yuzey === 'serpinti' ? '#34465A' : yuzey === 'renk' && renk ? renk : BEYAZ;
const izgara = yuzey === 'tuz' || (yuzey === 'renk' && renk);
const derz = zemin !== BEYAZ && koyuMu(zemin) ? ACIK_DERZ : KOYU_DERZ;
---
<svg class="ornek" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <defs><clipPath id={id}><circle cx="20" cy="20" r="20" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    {yuzey === 'renk' && !renk ? (
      <>
        <rect width="20" height="20" fill="#34465A" />
        <rect x="20" width="20" height="20" fill="#9A5A36" />
        <rect y="20" width="20" height="20" fill="#6E7959" />
        <rect x="20" y="20" width="20" height="20" fill="#3A3C3B" />
      </>
    ) : (
      <rect width="40" height="40" fill={zemin} />
    )}
    {izgara && (
      <g stroke={derz} stroke-width="1.15">
        <path d="M13.5 0V40M26.5 0V40M0 13.5H40M0 26.5H40" />
      </g>
    )}
    {yuzey === 'tuz-biber' && nokta.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#2A2B2A" />)}
    {yuzey === 'isaret' && nokta.map(([x, y, r], i) => <circle cx={x} cy={y} r={r * 1.1} fill={isaret[i % 4]} />)}
    {yuzey === 'serpinti' && nokta.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#EFECE6" />)}
    {yuzey === 'su-hatti' && (
      <>
        <rect y="27.5" width="40" height="12.5" fill="#9A5A36" />
        <g stroke={KOYU_DERZ} stroke-width="1.15"><path d="M13.5 0V27.5M26.5 0V27.5M0 13.5H40" /></g>
      </>
    )}
  </g>
  <circle cx="20" cy="20" r="19.5" fill="none" stroke="rgba(0,0,0,.14)" />
</svg>
