---
import { yol } from '../data/yol.js';
interface Props { ana?: boolean; ton?: 'koyu' | 'acik'; }
const { ana = false, ton = 'koyu' } = Astro.props;
const bolumler = [
  ['Koleksiyon', '#koleksiyon'],
  ['Masada', '#masada'],
  ['Yüzeyler', '#yuzeyler'],
  ['Hikâye', '#hikaye'],
];
---
<header class="ub" data-ub data-ton={ton} data-ana={ana ? '' : undefined}>
  <nav class="ub-sol" aria-label="Bölümler">
    {bolumler.map(([ad, h]) => <a class="ust" href={`${yol('')}${h}`}>{ad}</a>)}
  </nav>
  <a class="ub-marka" href={yol('')} aria-label="Savana Season, ana sayfa">Savana Season</a>
  <div class="ub-sag">
    <a class="ust ub-bag" href={yol('siparis/')}>Sipariş ve iade</a>
    <button class="ust ub-menu" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-ac>Menü</button>
  </div>
</header>

<dialog id="menu" class="menu koyu" aria-label="Menü" data-menu>
  <div class="menu-ust">
    <span class="ub-marka">Savana Season</span>
    <form method="dialog"><button class="ust" type="submit">Kapat</button></form>
  </div>
  <nav class="menu-liste" aria-label="Menü">
    {bolumler.map(([ad, h], i) => (
      <a href={`${yol('')}${h}`}><span class="mono">0{i + 1}</span><span class="baslik">{ad}</span></a>
    ))}
    <a href={yol('siparis/')}><span class="mono">05</span><span class="baslik">Sipariş</span></a>
  </nav>
  <p class="mono menu-alt">Elde dökülür · 14 gün iade</p>
</dialog>

<script>
  // Üst çubuk altındaki bölümün tonunu alır (koyu/açık); kaydırınca buzlu zemin
  const ub = document.querySelector<HTMLElement>('[data-ub]')!;
  let bolumler: HTMLElement[] = [];
  let bekliyor = false;
  const tara = () => {
    bekliyor = false;
    ub.classList.toggle('kaydi', scrollY > 8);
    const y = ub.offsetHeight / 2;
    for (const b of bolumler) {
      const r = b.getBoundingClientRect();
      if (r.top <= y && r.bottom > y) {
        if (ub.dataset.ton !== b.dataset.ton) ub.dataset.ton = b.dataset.ton!;
        break;
      }
    }
  };
  const iste = () => {
    if (!bekliyor) {
      bekliyor = true;
      requestAnimationFrame(tara);
    }
  };
  const topla = () => {
    bolumler = [...document.querySelectorAll<HTMLElement>('[data-ton]')].filter((e) => e !== ub && !e.closest('dialog'));
    tara();
  };
  topla();
  addEventListener('scroll', iste, { passive: true });
  addEventListener('resize', iste);

  // Telefon menüsü
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
  document.querySelector('[data-menu-ac]')!.addEventListener('click', () => menu.showModal());
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
</script>

<style>
  .ub {
    position: fixed; inset: 0 0 auto; z-index: 60; height: var(--ub-y);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding-inline: var(--kenar);
    color: var(--yazi);
    border-bottom: 1px solid transparent;
    transition: background-color .4s, color .4s, border-color .4s;
    view-transition-name: ust-cubuk;
  }
  .ub[data-ton='acik'] { color: var(--yazi); }
  .ub.kaydi { -webkit-backdrop-filter: blur(16px) saturate(1.3); backdrop-filter: blur(16px) saturate(1.3); }
  .ub.kaydi[data-ton='acik'] { background: rgb(243 243 241 / 0.8); border-color: var(--cizgi); }
  .ub.kaydi[data-ton='koyu'] { background: rgb(0 0 0 / 0.72); border-color: var(--cizgi); }
  .ub-sol { display: flex; gap: clamp(14px, 2vw, 30px); }
  .ub-sol a, .ub-bag, .ub-menu { opacity: .8; transition: opacity .2s; }
  .ub-sol a:hover, .ub-bag:hover, .ub-menu:hover { opacity: 1; }
  .ub-marka {
    font-family: var(--gotik); font-size: 26px; line-height: 1; white-space: nowrap;
    transition: opacity .45s, transform .6s var(--hiz);
  }
  .ub[data-ana]:not(.kaydi) .ub-marka { opacity: 0; transform: translateY(-6px); pointer-events: none; }
  .ub-sag { justify-self: end; display: flex; align-items: center; gap: 22px; }
  .ub-menu { display: none; }
  @media (max-width: 900px) {
    .ub { grid-template-columns: 1fr auto; }
    .ub-sol, .ub-bag { display: none; }
    .ub-menu { display: inline-flex; }
    .ub-marka { font-size: 23px; }
  }

  .menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0 var(--kenar) max(28px, env(safe-area-inset-bottom)); border: 0;
    display: none; flex-direction: column;
  }
  .menu[open] { display: flex; animation: menu-ac .45s var(--yay); }
  .menu::backdrop { background: transparent; }
  .menu-ust { height: var(--ub-y); display: flex; align-items: center; justify-content: space-between; }
  .menu-liste { display: grid; margin-top: 7vh; }
  .menu-liste a {
    display: flex; align-items: baseline; gap: 16px; padding: 12px 0;
    border-bottom: 1px solid var(--cizgi);
  }
  .menu-liste .mono { color: var(--soluk); }
  .menu-liste .baslik { font-size: clamp(40px, 11vw, 64px); }
  .menu-alt { margin-top: auto; color: var(--soluk); }
  @keyframes menu-ac { from { opacity: 0; transform: translateY(-10px); } }
</style>
