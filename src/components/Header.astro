---
import { yol } from '../data/yol.js';
const ev = yol('');
---
<header class="ust">
  <div class="ust-ic">
    <a class="marka" href={ev} aria-label="Savana Season, ana sayfa">
      <svg class="marka-iz" viewBox="0 0 24 28" aria-hidden="true">
        <path d="M3 27V12.5A11 11 0 0 1 12 1.6A11 11 0 0 1 21 12.5V27Z" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M12 27V9.5M7.4 27V15.5M16.6 27V15.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <span class="marka-ad">Savana Season</span>
    </a>
    <nav class="ust-menu" aria-label="Ana menü">
      <a href={`${ev}#koleksiyonlar`}>Koleksiyonlar</a>
      <a href={`${ev}#yuzeyler`} class="genis-ekran">Yüzeyler</a>
      <a href={`${ev}#hikaye`} class="genis-ekran">Hikâye</a>
      <a href={yol('siparis/')}>Sipariş</a>
    </nav>
  </div>
</header>

<script>
  const ust = document.querySelector('.ust');
  const bak = () => ust?.classList.toggle('kaydi', window.scrollY > 4);
  addEventListener('scroll', bak, { passive: true });
  bak();
</script>
