---
// Savana Season haç simgesi: dört eşit kollu gotik haç; her kol genişleyerek üç sivri uçla biter. Düz beyaz.
// Boyut yazı boyutuyla verilir (1em kare).
import { HAC } from '../data/amblem.js';
interface Props { class?: string }
const { class: sinif } = Astro.props;
---
<span class:list={['amblem', sinif]} aria-hidden="true">
  <svg viewBox="0 0 100 100" focusable="false"><path d={HAC} /></svg>
</span>

<style>
  .amblem { display: inline-grid; place-items: center; width: 1em; height: 1em; flex: none; }
  .amblem svg { width: 100%; height: 100%; fill: currentColor; }
</style>
