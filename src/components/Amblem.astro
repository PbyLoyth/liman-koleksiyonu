---
// Savana Season mührü: dört eşit kollu gotik haç; her kol genişleyerek üç sivri uçla biter.
// kor: arkasında yavaşça titreyen bir kor ışığı (alevli simgenin küçük boydaki karşılığı).
// Boyut yazı boyutuyla verilir (1em kare).
interface Props { kor?: boolean; class?: string }
const { kor = false, class: sinif } = Astro.props;
import { HAC } from '../data/amblem.js';
---
<span class:list={['amblem', sinif, { kor }]} aria-hidden="true">
  <svg viewBox="0 0 100 100" focusable="false"><path d={HAC} /></svg>
</span>

<style>
  .amblem { position: relative; display: inline-grid; place-items: center; width: 1em; height: 1em; flex: none; }
  .amblem svg { position: relative; width: 100%; height: 100%; fill: currentColor; }
  .kor::before {
    content: ''; position: absolute; inset: -55%; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 138 58 / 0.62), rgb(194 49 12 / 0.26) 52%, transparent);
    animation: kor 3.4s ease-in-out infinite;
  }
  @keyframes kor {
    0%, 100% { opacity: 0.55; transform: scale(0.94); }
    18% { opacity: 0.86; transform: scale(1.02); }
    41% { opacity: 0.6; transform: scale(0.97); }
    66% { opacity: 1; transform: scale(1.08) translateY(-2%); }
    82% { opacity: 0.68; }
  }
  @media (prefers-reduced-motion: reduce) { .kor::before { animation: none; opacity: 0.75; } }
</style>
