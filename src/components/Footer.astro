---
import { yol } from '../data/yol.js';
import { site } from '../data/site.js';
const k = site.siparis;
const kanalYok = !k.instagram && !k.whatsapp && !k.eposta;
---
<footer class="alt koyu" data-ton="koyu">
  <div class="kap alt-ust">
    <div class="alt-blok alt-tanim">
      <p class="ust">Savana Season</p>
      <p class="soluk">Elde dökülen beton objeler. Her parça siparişle, beyaz çimentodan dökülür.</p>
    </div>
    <nav class="alt-blok" aria-label="Koleksiyon">
      <p class="ust">Koleksiyon</p>
      <a href={`${yol('')}#katedral`}>Katedral</a>
      <a href={`${yol('')}#liman`}>Liman</a>
      <a href={`${yol('')}#yuzeyler`}>Yüzeyler</a>
    </nav>
    <nav class="alt-blok" aria-label="Bilgi">
      <p class="ust">Bilgi</p>
      <a href={yol('siparis/')}>Sipariş ve iade</a>
      <a href={yol('siparis/#gizlilik')}>Gizlilik</a>
    </nav>
    <div class="alt-blok">
      <p class="ust">İletişim</p>
      {k.instagram && <a href={`https://instagram.com/${k.instagram}`} target="_blank" rel="noopener">Instagram</a>}
      {k.whatsapp && <a href={`https://wa.me/${k.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
      {k.eposta && <a href={`mailto:${k.eposta}`}>{k.eposta}</a>}
      {kanalYok && <p class="soluk">Sipariş kanalı çok yakında.</p>}
    </div>
  </div>
  <div class="alt-dev" aria-hidden="true"><span class="marka krom">Savana Season</span></div>
  <div class="kap alt-son mono">
    <span>© {new Date().getFullYear()} Savana Season</span>
    <span>Elde dökülür · Beyaz çimento</span>
  </div>
</footer>

<style>
  .alt { padding-top: clamp(56px, 8vw, 110px); overflow: hidden; }
  .alt-ust {
    display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 32px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .alt-blok { display: grid; align-content: start; gap: 10px; font-size: 14px; }
  .alt-blok .ust { margin-bottom: 6px; }
  .alt-blok a { width: fit-content; opacity: .82; transition: opacity .2s; }
  .alt-blok a:hover { opacity: 1; }
  .alt-tanim p:last-child { max-width: 34ch; }
  .alt-dev { border-top: 1px solid var(--cizgi); text-align: center; padding-top: .06em; }
  .alt-dev span { display: block; font-size: 15.4vw; line-height: .92; white-space: nowrap; letter-spacing: -.005em; }
  .alt-son {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-block: 18px max(22px, env(safe-area-inset-bottom)); color: var(--soluk);
    border-top: 1px solid var(--cizgi);
  }
  @media (max-width: 760px) {
    .alt-ust { grid-template-columns: 1fr 1fr; }
    .alt-tanim { grid-column: 1 / -1; }
  }
</style>
