---
// Arşiv: baştan sona bütün çalışmalar, göstermek için. Menüde yok, alt bilgide soluk bir bağlantı; arama motorlarına kapalı.
// Görseller ve src/data/arsiv.json: node tools/arsiv.mjs. Her öğenin kendi bağlantısı var: /arsiv/#<öğe>
import Taban from '../layouts/Taban.astro';
import arsiv from '../data/arsiv.json';
import { yol } from '../data/gorsel.js';

const { bolumler } = arsiv;
const toplam = bolumler.reduce((t, b) => t + b.sayi, 0);
const birim: Record<string, string> = { resim: 'görsel', donus: 'dönüş', film: 'film' };
---
<Taban baslik="Arşiv — Savana Season" aciklama="Savana Season arşivi: baştan sona bütün çalışmalar." dizin={false}>
  <header class="a-bas kap">
    <h1 class="marka a-baslik">Arşiv</h1>
    <p class="harf soluk">21–22 Kasım 2026 · {toplam} çalışma · {bolumler.length} bölüm</p>
  </header>

  <nav class="a-dizin" aria-label="Bölümler">
    <div class="a-dizin-ic kap" data-dizin-kap>
      {bolumler.map((b) => <a class="harf" href={`#${b.id}`} data-dizin={b.id}><span>{b.no}</span>{b.ad}</a>)}
    </div>
  </nav>

  {bolumler.map((b) => (
    <section class="a-bolum kap" id={b.id} aria-labelledby={`${b.id}-ad`}>
      <header class="a-bolum-bas">
        <p class="harf soluk">{b.no} · {b.tarih}</p>
        <h2 class="ekran a-bolum-ad" id={`${b.id}-ad`}>{b.ad}</h2>
        <p class="soluk a-not">{b.not} <span class="a-sayi">{b.sayi} {birim[b.tur]}</span></p>
      </header>
      {b.gruplar.map((g) => (
        <div class="a-grup">
          {g.ad && <h3 class="harf soluk a-grup-ad">{g.ad}</h3>}
          <div class="a-sira">
            {g.ogeler.map((o) => (
              <a class={`a-oge a-${o.tur}`} id={o.id} href={yol(o.b)} data-oge data-tur={o.tur}
                 data-kare={o.kare} data-sutun={o.sutun} style={`--a:${(o.kw / o.kh).toFixed(4)}`}>
                <img src={yol(o.k)} width={o.kw} height={o.kh} alt={o.ad} loading="lazy" decoding="async" />
                {o.tur === 'donus' && <span class="a-rozet harf">360°</span>}
                {o.tur === 'film' && <span class="a-rozet harf">Film</span>}
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}

  <dialog class="gos" id="gosterici" aria-label="Arşiv">
    <div class="gos-sahne" data-sahne>
      <img class="gos-resim" data-resim alt="" decoding="async" />
      <div class="gos-donus" data-donus role="img" hidden></div>
      <video class="gos-film" data-film controls loop playsinline muted preload="metadata" hidden></video>
    </div>
    <div class="gos-ust">
      <p class="harf soluk" data-sayac></p>
      <div class="gos-dugmeler">
        <button class="harf" type="button" data-tam hidden>Tam ekran</button>
        <button class="harf" type="button" data-kapat>Kapat</button>
      </div>
    </div>
    <div class="gos-alt">
      <button class="gos-ok gos-onceki" type="button" aria-label="Önceki" data-onceki>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </button>
      <div class="gos-bilgi">
        <p class="harf soluk" data-bolum-ad></p>
        <p class="gos-ad" data-ad></p>
        <p class="harf soluk gos-ipucu" data-ipucu hidden>Sürükle, döndür</p>
      </div>
      <button class="gos-ok gos-sonraki" type="button" aria-label="Sonraki" data-sonraki>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </button>
    </div>
  </dialog>
</Taban>

<script>
  const dlg = document.getElementById('gosterici') as HTMLDialogElement;
  const ogeler = [...document.querySelectorAll<HTMLAnchorElement>('[data-oge]')];
  const q = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
  const sahne = q('[data-sahne]'), resim = q<HTMLImageElement>('[data-resim]');
  const donus = q('[data-donus]'), film = q<HTMLVideoElement>('[data-film]');
  const azalt = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = -1;
  let durdur: (() => void) | null = null;

  const kucuk = (o: HTMLAnchorElement) => o.querySelector('img')!;

  function temizle() {
    durdur?.();
    durdur = null;
    film.pause();
    film.removeAttribute('src');
    film.load();
  }

  // 360°: tek dosyalık kare şeridi; kendiliğinden yavaş döner, sürükleyince elle
  function donusKur(o: HTMLAnchorElement) {
    const kare = +o.dataset.kare!, sutun = +o.dataset.sutun!, satir = kare / sutun;
    let k = 0, hazir = false, oto = !azalt, son = 0, raf = 0, bas: number | null = null, k0 = 0;
    donus.style.backgroundImage = `url("${kucuk(o).src}")`;
    donus.style.backgroundSize = 'contain';
    donus.style.backgroundPosition = 'center';
    const ciz = () => {
      if (!hazir) return;
      const c = k % sutun, r = Math.floor(k / sutun);
      donus.style.backgroundPosition = `${(c / (sutun - 1)) * 100}% ${(r / (satir - 1)) * 100}%`;
    };
    const serit = new Image();
    serit.onload = () => {
      if (ogeler[i] !== o) return;
      hazir = true;
      donus.style.backgroundImage = `url("${o.href}")`;
      donus.style.backgroundSize = `${sutun * 100}% ${satir * 100}%`;
      ciz();
    };
    serit.src = o.href;
    const dongu = (t: number) => {
      raf = requestAnimationFrame(dongu);
      if (oto && hazir && t - son > 90) { son = t; k = (k + 1) % kare; ciz(); }
    };
    raf = requestAnimationFrame(dongu);
    const adim = () => Math.max(5, donus.clientWidth / kare / 1.1);
    const indir = (e: PointerEvent) => { bas = e.clientX; k0 = k; oto = false; donus.setPointerCapture(e.pointerId); };
    const kaydir = (e: PointerEvent) => {
      if (bas === null) return;
      const d = Math.round((e.clientX - bas) / adim());
      k = (((k0 - d) % kare) + kare) % kare;
      ciz();
    };
    const birak = () => { bas = null; };
    donus.addEventListener('pointerdown', indir);
    donus.addEventListener('pointermove', kaydir);
    donus.addEventListener('pointerup', birak);
    donus.addEventListener('pointercancel', birak);
    return () => {
      cancelAnimationFrame(raf);
      donus.removeEventListener('pointerdown', indir);
      donus.removeEventListener('pointermove', kaydir);
      donus.removeEventListener('pointerup', birak);
      donus.removeEventListener('pointercancel', birak);
    };
  }

  function goster(n: number) {
    temizle();
    i = (n + ogeler.length) % ogeler.length;
    const o = ogeler[i], tur = o.dataset.tur!, img = kucuk(o);
    sahne.dataset.tur = tur;
    resim.hidden = tur !== 'resim';
    donus.hidden = tur !== 'donus';
    film.hidden = tur !== 'film';
    if (tur === 'resim') {
      // önce küçük görsel (anında), büyüğü gelince değiştir
      const tam = new Image();
      tam.src = o.href;
      if (tam.complete) resim.src = o.href;
      else {
        resim.src = img.src;
        tam.onload = () => { if (ogeler[i] === o) resim.src = o.href; };
      }
      resim.alt = img.alt;
    } else if (tur === 'donus') {
      donus.setAttribute('aria-label', img.alt);
      durdur = donusKur(o);
    } else {
      film.poster = img.src;
      film.src = o.href;
      film.play().catch(() => {});
    }
    const bolum = o.closest('.a-bolum')!;
    const liste = [...bolum.querySelectorAll('[data-oge]')];
    q('[data-sayac]').textContent = `${liste.indexOf(o) + 1} / ${liste.length}`;
    q('[data-bolum-ad]').textContent = bolum.querySelector('.a-bolum-ad')!.textContent;
    q('[data-ad]').textContent = img.alt;
    q('[data-ipucu]').hidden = tur !== 'donus';
    history.replaceState(null, '', `#${o.id}`);
    // komşu görselleri önceden yükle
    for (const d of [1, -1]) {
      const k = ogeler[(i + d + ogeler.length) % ogeler.length];
      if (k.dataset.tur === 'resim') new Image().src = k.href;
    }
  }

  function ac(n: number) {
    goster(n);
    if (!dlg.open) {
      document.documentElement.classList.add('kilit');
      dlg.showModal();
    }
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-oge]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // yeni sekmede açmak serbest
    e.preventDefault();
    ac(ogeler.indexOf(a));
  });
  q('[data-onceki]').addEventListener('click', () => goster(i - 1));
  q('[data-sonraki]').addEventListener('click', () => goster(i + 1));
  q('[data-kapat]').addEventListener('click', () => dlg.close());
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); goster(i + 1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); goster(i - 1); }
    else if (e.key === 'f' || e.key === 'F') tamEkran();
  });
  dlg.addEventListener('close', () => {
    temizle();
    document.documentElement.classList.remove('kilit');
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    history.replaceState(null, '', location.pathname);
    const o = ogeler[i];
    if (o) { o.scrollIntoView({ block: 'center' }); o.focus({ preventScroll: true }); }
  });

  // dokunmatik: yana kaydırınca önceki/sonraki (360° sahnesinde sürükleme dönüş içindir)
  let sx: number | null = null, sy = 0;
  sahne.addEventListener('pointerdown', (e) => {
    if (sahne.dataset.tur === 'donus' || e.pointerType === 'mouse') return;
    sx = e.clientX;
    sy = e.clientY;
  });
  sahne.addEventListener('pointerup', (e) => {
    if (sx === null) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    sx = null;
    if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) goster(i + (dx < 0 ? 1 : -1));
  });
  sahne.addEventListener('pointercancel', () => { sx = null; });

  // tam ekran (sunum için; iPhone'da yok)
  const tam = q<HTMLButtonElement>('[data-tam]');
  function tamEkran() {
    if (!document.fullscreenEnabled) return;
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    else document.documentElement.requestFullscreen().catch(() => {});
  }
  if (document.fullscreenEnabled) {
    tam.hidden = false;
    tam.addEventListener('click', tamEkran);
    document.addEventListener('fullscreenchange', () => { tam.textContent = document.fullscreenElement ? 'Küçült' : 'Tam ekran'; });
  }

  // bağlantıyla gelen öğeyi aç: /arsiv/#katedral-kemer-aci-grafit
  const hashAc = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const n = id ? ogeler.findIndex((o) => o.id === id) : -1;
    if (n >= 0) ac(n);
  };
  hashAc();
  addEventListener('hashchange', () => { if (!dlg.open) hashAc(); });

  // bölüm dizini: görünen bölümü işaretle, şeridi ona kaydır
  const dizinKap = document.querySelector<HTMLElement>('[data-dizin-kap]')!;
  const dizin = new Map([...document.querySelectorAll<HTMLElement>('[data-dizin]')].map((a) => [a.dataset.dizin!, a]));
  const gozcu = new IntersectionObserver((es) => {
    for (const e of es) {
      if (!e.isIntersecting) continue;
      for (const a of dizin.values()) a.classList.remove('etkin');
      const a = dizin.get(e.target.id);
      if (!a) continue;
      a.classList.add('etkin');
      dizinKap.scrollTo({ left: a.offsetLeft - dizinKap.clientWidth / 2 + a.clientWidth / 2, behavior: azalt ? 'auto' : 'smooth' });
    }
  }, { rootMargin: '-35% 0px -60% 0px' });
  document.querySelectorAll('.a-bolum').forEach((s) => gozcu.observe(s));
</script>

<style>
  .a-bas { display: grid; justify-items: center; gap: 14px; text-align: center; padding-block: clamp(56px, 9vw, 120px) clamp(36px, 5vw, 64px); }
  .a-baslik { font-size: clamp(64px, 10vw, 140px); }

  /* bölüm dizini: üst şeridin altında yapışık, yana kayar */
  .a-dizin {
    position: sticky; top: var(--ust); z-index: 20;
    background: rgb(0 0 0 / 0.86); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-block: 1px solid var(--cizgi);
  }
  .a-dizin-ic { display: flex; gap: 26px; overflow-x: auto; scrollbar-width: none; white-space: nowrap; padding-block: 13px; }
  .a-dizin-ic::-webkit-scrollbar { display: none; }
  .a-dizin a { color: var(--soluk); transition: color .2s; }
  .a-dizin a span { margin-right: 8px; opacity: .55; }
  .a-dizin a:hover, .a-dizin a.etkin { color: var(--yazi); }

  .a-bolum { padding-top: clamp(64px, 8vw, 112px); scroll-margin-top: calc(var(--ust) + 24px); }
  .a-bolum-bas { display: grid; gap: 8px; max-width: 70ch; margin-bottom: 28px; }
  .a-bolum-ad { font-size: clamp(26px, 3vw, 40px); }
  .a-not { font-size: 15px; }
  .a-sayi { white-space: nowrap; margin-left: 6px; color: var(--yazi); opacity: .7; }
  .a-grup + .a-grup { margin-top: 28px; }
  .a-grup-ad { margin-bottom: 12px; }

  /* iki yana yaslı sıra: her görsel kendi oranında, sıralar tam genişlikte (son sıra serbest) */
  .a-sira { --h: 200px; display: flex; flex-wrap: wrap; gap: 6px; }
  .a-sira::after { content: ''; flex-grow: 1000000; }
  @media (max-width: 1100px) { .a-sira { --h: 160px; } }
  @media (max-width: 720px) { .a-sira { --h: 104px; gap: 4px; } }
  .a-oge {
    position: relative; overflow: hidden; background: #0b0b0b;
    flex: calc(var(--a) * 1000) 1 calc(var(--a) * var(--h));
    scroll-margin-top: calc(var(--ust) + 72px);
  }
  .a-oge img { width: 100%; height: auto; aspect-ratio: var(--a); object-fit: cover; transition: opacity .35s var(--yavas); }
  .a-oge:hover img { opacity: .72; }
  .a-donus { background: radial-gradient(70% 55% at 50% 66%, #242426 0%, #0b0b0b 72%); }
  .a-rozet {
    position: absolute; left: 7px; bottom: 7px; padding: 3px 6px 2px; font-size: 9.5px; line-height: 1.4;
    background: rgb(0 0 0 / 0.6); color: #fff; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }

  /* gösterici: tam sayfa siyah */
  .gos {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: #000; color: var(--yazi); overflow: hidden;
  }
  .gos::backdrop { background: #000; }
  .gos-sahne { position: absolute; inset: 60px 84px 104px; display: grid; place-items: center; touch-action: pinch-zoom; }
  .gos-resim, .gos-film { width: 100%; height: 100%; object-fit: contain; }
  .gos-sahne[data-tur='donus'] { background: radial-gradient(42% 46% at 50% 60%, #1c1c1e 0%, #000 74%); }
  .gos-donus {
    height: min(100%, calc((100vw - 168px) * 1.25)); aspect-ratio: 4 / 5;
    background-repeat: no-repeat; cursor: grab; touch-action: none; user-select: none;
  }
  .gos-donus:active { cursor: grabbing; }
  .gos-ust {
    position: absolute; inset: 0 0 auto; height: 60px; padding-inline: var(--kenar);
    display: flex; align-items: center; justify-content: space-between;
  }
  .gos-dugmeler { display: flex; gap: 26px; }
  .gos-dugmeler button { color: var(--soluk); transition: color .2s; }
  .gos-dugmeler button:hover { color: var(--yazi); }
  .gos-alt {
    position: absolute; inset: auto 0 0; min-height: 104px;
    padding: 12px var(--kenar) calc(16px + env(safe-area-inset-bottom));
    display: grid; grid-template-columns: 56px 1fr 56px; align-items: center;
  }
  .gos-bilgi { display: grid; justify-items: center; gap: 4px; text-align: center; min-width: 0; }
  .gos-ad { font-size: 15px; }
  .gos-ok { width: 56px; height: 56px; display: grid; place-items: center; color: var(--soluk); transition: color .2s; }
  .gos-ok:hover { color: var(--yazi); }
  /* geniş ekranda oklar iki yanda, ortada */
  @media (min-width: 721px) {
    .gos-ok { position: fixed; top: 50%; translate: 0 -50%; width: 72px; height: 120px; }
    .gos-onceki { left: 6px; }
    .gos-sonraki { right: 6px; }
    .gos-ok svg { width: 30px; height: 30px; }
  }
  @media (max-width: 720px) {
    .gos-sahne { inset: 56px 0 112px; }
    .gos-donus { height: min(100%, calc(100vw * 1.25)); }
  }
  :global(html.kilit) { overflow: hidden; }
</style>
