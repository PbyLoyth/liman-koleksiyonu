---
import Base from '../layouts/Base.astro';
import { yol } from '../data/yol.js';
---
<Base baslik="Sayfa bulunamadı — Savana Season" ton="koyu">
  <section class="bos koyu" data-ton="koyu">
    <p class="mono soluk">Hata 404</p>
    <h1 class="baslik">Kayıp taş.</h1>
    <p class="soluk">Bu sayfa burada değil; bağlantı değişmiş olabilir.</p>
    <a class="dugme" href={yol('')}>Ana sayfaya dön</a>
  </section>
</Base>

<style>
  .bos {
    min-height: 88svh; display: grid; place-content: center; justify-items: center; gap: 22px;
    text-align: center; padding: calc(var(--ub-y) + 40px) var(--kenar) 80px;
  }
  .bos h1 { font-size: clamp(56px, 9vw, 140px); }
</style>
