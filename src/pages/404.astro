---
import Taban from '../layouts/Taban.astro';
import Amblem from '../components/Amblem.astro';
import { yol } from '../data/gorsel.js';
---
<Taban baslik="Bulunamadı — Savana Season">
  <section class="kap bos">
    <span class="bos-muhur"><Amblem /></span>
    <p class="harf soluk">404</p>
    <h1 class="harf">Bu sayfa burada değil</h1>
    <a class="harf soluk" href={yol('')}>← Ana sayfa</a>
  </section>
</Taban>

<style>
  .bos { min-height: 64svh; display: grid; place-content: center; justify-items: center; gap: 18px; text-align: center; }
  .bos-muhur { font-size: 72px; margin-bottom: 18px; }
  .bos a:hover { color: var(--yazi); }
</style>
