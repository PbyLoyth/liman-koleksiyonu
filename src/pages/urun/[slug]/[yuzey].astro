---
import UrunSayfasi from '../../../components/UrunSayfasi.astro';
import { urunler } from '../../../data/urunler.js';
import { yuzeyler } from '../../../data/yuzeyler.js';
import { cekildi } from '../../../data/gorseller.js';

// Her yüzeyin kendi adresi var: paylaşılan bağlantı o yüzeyin görseliyle açılır
export function getStaticPaths() {
  return urunler.flatMap((u) =>
    yuzeyler.filter((y) => y.id !== 'tuz' && cekildi(u.slug, y.id)).map((y) => ({ params: { slug: u.slug, yuzey: y.id }, props: { u, yuzey: y.id } })),
  );
}
const { u, yuzey } = Astro.props;
---
<UrunSayfasi u={u} secili={yuzey} />
