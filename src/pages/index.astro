---
import Taban from '../layouts/Taban.astro';
import KoleksiyonKart from '../components/KoleksiyonKart.astro';
import { marka, koleksiyonlar } from '../data/koleksiyon.js';
import { genis, yol, var_, dosyaVar } from '../data/gorsel.js';

// Giriş: tam ekran, yavaş bir film döngüsü (Chrome Hearts düzeni). Önce afiş görseli görünür, video hazır olunca
// üstüne açılır. Dikey ekranda ayrı dikey çekim. Hareket azaltma ya da veri tasarrufu açıksa yalnız afiş kalır.
const yeniGiris = var_('giris-yatay', 1920);
const yatay = yeniGiris
  ? { src: yol('g/giris-yatay-1920.webp'), srcset: `${yol('g/giris-yatay-1280.webp')} 1280w, ${yol('g/giris-yatay-1920.webp')} 1920w, ${yol('g/giris-yatay-2560.webp')} 2560w` }
  : genis('kampanya-katedral');
const dikey = var_('giris-dikey', 1080) ? `${yol('g/giris-dikey-720.webp')} 720w, ${yol('g/giris-dikey-1080.webp')} 1080w` : null;
const video = dosyaVar('g/giris-yatay.mp4');
---
<Taban saydam>
  <section class="giris" data-giris aria-label="Giriş">
    <picture class="giris-afis">
      {dikey && <source media="(max-aspect-ratio: 4/5)" srcset={dikey} sizes="100vw" />}
      <img src={yatay.src} srcset={yatay.srcset} sizes="100vw" width="1920" height="1080" alt="Çarmıh sahnesi: karanlık gökyüzünün altında üç haç, bulutlardan inen bir ışık huzmesi ve melekler; tepenin çevresinde kalabalık. 19. yüzyıl tablosu." fetchpriority="high" decoding="async" />
    </picture>
    {video && (
      <video class="giris-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
        data-yatay={yol('g/giris-yatay')} data-dikey={dosyaVar('g/giris-dikey.mp4') ? yol('g/giris-dikey') : ''}></video>
    )}
    <a class="kaydir harf" href="#koleksiyon"><span>Kaydır</span><i aria-hidden="true"></i></a>
  </section>

  <section class="kap" id="koleksiyon" aria-label="Koleksiyonlar" data-koleksiyon-kok={yol('koleksiyon/')} data-idler={koleksiyonlar.map((k) => k.id).join(' ')}>
    <h2 class="giris-satir ekran">{marka.tutku}</h2>
    <p class="harf soluk ortali">{marka.koleksiyon} — {marka.slogan}</p>
    <ul class="kk-izgara girisler">
      {koleksiyonlar.map((k) => <KoleksiyonKart k={k} />)}
    </ul>
  </section>
</Taban>

<script>
  // Giriş videosu: yön (yatay/dikey) ekrana göre seçilir; hareket azaltma ya da veri tasarrufunda hiç yüklenmez
  const v = document.querySelector<HTMLVideoElement>('.giris-video');
  const sakin = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
  if (v && !sakin) {
    const dikeyEkran = matchMedia('(max-aspect-ratio: 4/5)');
    let kok = '';
    const yukle = () => {
      const yeni = dikeyEkran.matches && v.dataset.dikey ? v.dataset.dikey : v.dataset.yatay!;
      if (yeni === kok) return;
      kok = yeni;
      v.classList.remove('oynuyor');
      v.innerHTML = `<source src="${kok}.webm" type="video/webm"><source src="${kok}.mp4" type="video/mp4">`;
      v.load();
      v.play().catch(() => {});
    };
    v.addEventListener('playing', () => v.classList.add('oynuyor'));
    yukle();
    dikeyEkran.addEventListener('change', yukle);
  }

  // Koleksiyonlar artık kendi sayfalarında; eski bağlantılar (/#katedral) oraya gider
  const bolum = document.querySelector<HTMLElement>('[data-koleksiyon-kok]')!;
  const eski = location.hash.slice(1);
  if (bolum.dataset.idler!.split(' ').includes(eski)) location.replace(`${bolum.dataset.koleksiyonKok}${eski}/`);
</script>

<style>
  .giris { position: relative; height: 100svh; min-height: 520px; overflow: hidden; background: var(--siyah); }
  .giris-afis img, .giris-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* tablo yerinde durur, çok yavaş yaklaşıp uzaklaşır */
  .giris-afis img { transform-origin: 54% 46%; animation: nefes 28s ease-in-out infinite alternate; }
  @keyframes nefes { from { transform: scale(1); } to { transform: scale(1.06); } }
  .giris-video { opacity: 0; transition: opacity 1.4s var(--yavas); }
  .giris-video.oynuyor { opacity: 1; }
  .giris::after {
    content: ''; position: absolute; inset: auto 0 0; height: 34%; pointer-events: none;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
  }
  .kaydir {
    position: absolute; left: 50%; bottom: max(26px, env(safe-area-inset-bottom)); z-index: 2; transform: translateX(-50%);
    display: grid; justify-items: center; gap: 10px; font-size: 10px; color: var(--yazi);
  }
  .kaydir i { position: relative; width: 1px; height: 46px; overflow: hidden; background: rgb(255 255 255 / 0.22); }
  .kaydir i::after {
    content: ''; position: absolute; inset: 0; background: var(--yazi);
    transform: translateY(-100%); animation: akis 2.4s var(--yavas) infinite;
  }
  @keyframes akis { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

  .giris-satir { text-align: center; padding-top: clamp(72px, 9vw, 128px); }
  .giris-satir { font-size: clamp(30px, 4vw, 56px); }
  .ortali { text-align: center; margin-top: 14px; }
  .girisler { padding-top: clamp(48px, 6vw, 88px); }
  @media (prefers-reduced-motion: reduce) { .kaydir i::after, .giris-afis img { animation: none; transform: none; } }
</style>
