---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import UrunKart from '../components/UrunKart.astro';
import Ornek from '../components/Ornek.astro';
import { urunler } from '../data/urunler.js';
import { yuzeyler } from '../data/yuzeyler.js';
import { koleksiyonGorseli, kapakGorseli, kapakGenis, urunGorseli } from '../data/gorseller.js';
import { yol, urunYolu } from '../data/yol.js';

const satista = urunler.filter((u) => !u.yakinda);
const yakinda = urunler.filter((u) => u.yakinda);
// Kapak: telefonda 5:4, genişte 2:1 çekim (yanlarda daha çok zemin)
const darKapak = await getImage({ src: kapakGorseli(), widths: [640, 960, 1280], format: 'webp', quality: 74 });
const genisKapak = kapakGenis() ? await getImage({ src: kapakGenis(), widths: [1280, 1920, 2560], format: 'webp', quality: 74 }) : null;
---
<Base>
  <section class="kapak">
    <div class="kap kapak-metin">
      <p class="ust-baslik">Liman Koleksiyonu</p>
      <h1>Limandan masaya.</h1>
      <p class="kapak-alt">Dalgakıranlardan, iskele babalarından ve silolardan doğan beton objeler.</p>
      <div class="eylem">
        <a class="dugme" href="#urunler">Ürünlere bak</a>
        <a class="bag" href="#hikaye">Hikâyesi <span aria-hidden="true">›</span></a>
      </div>
    </div>
    <div class="kap kap-genis">
      <picture>
        {genisKapak && <source media="(min-width: 700px)" srcset={genisKapak.srcSet.attribute} sizes="(min-width: 1440px) 1360px, 100vw" />}
        <img
          class:list={['kapak-gorsel', genisKapak && 'kapak-iki']}
          src={darKapak.src}
          srcset={darKapak.srcSet.attribute}
          sizes="100vw"
          width="1600"
          height="1280"
          alt="Koleksiyonun yedi parçası kaba beton zemin üzerinde, üstten: tepsi, lamba, kalemlik, iki kitap desteği, iki şamdan, kâğıt ağırlığı ve tütsülük"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <section id="urunler" class="bolum">
    <div class="kap">
      <div class="bolum-bas">
        <h2>Ürünler</h2>
        <p>Her parça limandaki bir yapıdan.</p>
      </div>
      <div class="izgara">
        {satista.map((u) => <UrunKart u={u} />)}
      </div>
      {yakinda.map((u) => (
        <a class="yakinda" href={urunYolu(u.slug)}>
          <div class="yakinda-metin">
            <span class="rozet">Yakında</span>
            <h3>{u.ad}</h3>
            <p class="yakinda-rol">{u.rol}</p>
            <p>{u.metin}</p>
            <span class="bag">İncele <span aria-hidden="true">›</span></span>
          </div>
          <Image
            class="yakinda-gorsel"
            src={urunGorseli(u.slug, 'renk', 'aci')}
            quality={74} widths={[480, 720, 960]}
            sizes="(min-width: 900px) 36vw, 100vw"
            alt={`${u.ad} masa lambası, açıdan`}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </section>

  <section id="yuzeyler" class="bolum yuzey-bolum">
    <div class="kap">
      <div class="bolum-bas">
        <h2>Altı yüzey</h2>
        <p>Her parça altı yüzeyle dökülür. Sıçramalar elde atılır; her parçada başka yere düşer.</p>
      </div>
      <div class="yz-sahne" data-yz-sahne>
        {yuzeyler.map((y, i) => (
          <Image
            class:list={['yz-gorsel', i === 0 && 'etkin']}
            src={koleksiyonGorseli(y.id)}
            quality={74} widths={[960, 1440, 2000]}
            sizes="(min-width: 1240px) 1180px, 100vw"
            alt={`Koleksiyon, ${y.ad} yüzeyle`}
            loading="lazy"
            hidden={i !== 0}
            data-yz={y.id}
          />
        ))}
      </div>
      <div class="yz-secim" role="tablist" aria-label="Yüzey">
        {yuzeyler.map((y, i) => (
          <button
            type="button"
            role="tab"
            class="yz-dugme"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-yz={y.id}
            data-metin={y.metin}
          >
            <Ornek yuzey={y.id} />
            <span>{y.ad}</span>
          </button>
        ))}
      </div>
      <p class="yz-metin" aria-live="polite" data-yz-metin>{yuzeyler[0].metin}</p>
    </div>
  </section>

  <section id="hikaye" class="bolum hikaye">
    <div class="kap hikaye-ic">
      <div class="hikaye-metin">
        <h2>Limanda süs yok.</h2>
        <p>Her yapının bir işi var. Dalgakıran bloğu dalgayı kırar, baba halatı tutar, keson suyun altında yükü taşır. Biçim işten gelir.</p>
        <p>Bu koleksiyon o yapıları masaya küçültüyor ve onlara yeni bir iş veriyor: dalgakıran kitap tutuyor, baba mum, keson anahtar.</p>
        <p>Her parça beyaz çimentoyla elde dökülür. Yüzeydeki ince çizgiler kalıpta oluşur ve harçla tek tek doldurulur, karo derzi gibi.</p>
      </div>
      <Image
        class="hikaye-gorsel"
        src={urunGorseli('keson', 'tuz', 'kullanim')}
        quality={74} widths={[480, 720, 960, 1280]}
        sizes="(min-width: 900px) 44vw, 100vw"
        alt="KESON kullanımda, üstten: telefon, kulaklık kutusu, yüzük ve bozuk para hücrelerinde"
        loading="lazy"
      />
    </div>
  </section>

  <section id="nasil" class="bolum">
    <div class="kap">
      <div class="bolum-bas">
        <h2>Sipariş</h2>
        <p>Üç adımda.</p>
      </div>
      <ol class="adimlar">
        <li><span class="adim-no">1</span><h3>Seç</h3><p>Parçayı ve yüzeyini seç.</p></li>
        <li><span class="adim-no">2</span><h3>Yaz</h3><p>Sipariş düğmesi mesajını hazırlar, sen gönderirsin.</p></li>
        <li><span class="adim-no">3</span><h3>Dökülür, gelir</h3><p>Parçan elde dökülür, kürünü alır ve kargoya verilir.</p></li>
      </ol>
      <p class="iade-not">
        Teslimden sonra 14 gün içinde iade edebilirsin; iade kargosu bizden.
        <a href={yol('siparis/')}>Sipariş ve iade <span aria-hidden="true">›</span></a>
      </p>
    </div>
  </section>
</Base>

<script>
  // Altı yüzey: sekme seçimi koleksiyon görselini yumuşak geçişle değiştirir
  const sahne = document.querySelector<HTMLElement>('[data-yz-sahne]');
  const metin = document.querySelector<HTMLElement>('[data-yz-metin]');
  const dugmeler = [...document.querySelectorAll<HTMLButtonElement>('.yz-dugme')];
  let istenen = 0;
  const gorsel = (id: string) => sahne?.querySelector<HTMLImageElement>(`img[data-yz="${id}"]`);

  async function sec(i: number) {
    istenen = i;
    const d = dugmeler[i];
    dugmeler.forEach((b, j) => {
      b.setAttribute('aria-selected', String(j === i));
      b.tabIndex = j === i ? 0 : -1;
    });
    if (metin) metin.textContent = d.dataset.metin ?? '';
    const yeni = gorsel(d.dataset.yz ?? '');
    const eski = sahne?.querySelector<HTMLImageElement>('img.etkin');
    if (!yeni || yeni === eski) return;
    yeni.hidden = false;
    try { await yeni.decode(); } catch {}
    if (istenen !== i) return;
    sahne?.querySelectorAll('img.etkin').forEach((e) => e.classList.remove('etkin'));
    yeni.classList.add('etkin');
    setTimeout(() => {
      sahne?.querySelectorAll<HTMLImageElement>('img.yz-gorsel:not(.etkin)').forEach((e) => (e.hidden = true));
    }, 520);
  }

  dugmeler.forEach((d, i) => {
    d.addEventListener('click', () => sec(i));
    d.addEventListener('pointerenter', () => {
      const im = gorsel(d.dataset.yz ?? '');
      if (im) im.loading = 'eager';
    });
    d.addEventListener('keydown', (e) => {
      const yon = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!yon) return;
      e.preventDefault();
      const j = (i + yon + dugmeler.length) % dugmeler.length;
      dugmeler[j].focus();
      sec(j);
    });
  });
</script>
