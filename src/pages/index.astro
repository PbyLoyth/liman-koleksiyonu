---
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import UrunKart from '../components/UrunKart.astro';
import Ornek from '../components/Ornek.astro';
import Kayan from '../components/Kayan.astro';
import Isaret from '../components/Isaret.astro';
import { urunler, koleksiyonlar } from '../data/urunler.js';
import { yuzeyler, yuzeyBul, malzemeler, tamAd } from '../data/yuzeyler.js';
import {
  donusKok, kapakKok, ilkKare, masadaGorsel, sahneler, cekildi, foto, fotoVar, kapakFoto, cekimAdi, KARE, KAPAK_KARE,
} from '../data/gorseller.js';
import { konseptler, atolye, konseptGorsel, konseptVar, kampanya, kampanyaVar } from '../data/konsept.js';
import { yol, urunYolu } from '../data/yol.js';

const gorunen = urunler.filter((u) => !u.gizli);

// Kapak dönüşü 48 kare (kapak/<ürün>); yoksa ürünün 24 karelik Tuz dönüşü
const KAPAK = existsSync('public/donus/kapak/kemer-kara/b/00.webp') ? 'kemer-kara' : 'kemer'; // kara çelik Kemer
const kapakVar = existsSync(`public/donus/kapak/${KAPAK}/b/00.webp`);
const kapakYolu = kapakVar ? kapakKok(KAPAK) : donusKok('kemer', 'tuz');
const kapak = ilkKare(kapakYolu);
const DIZI = 'sapel';
// Masada: yalnız beton ya da çelik sahneler (renkli yüzeyli eski sahneler gösterilmez)
const masada = Object.keys(sahneler)
  .map((slug) => ({ u: gorunen.find((x) => x.slug === slug), ...sahneler[slug], img: masadaGorsel(slug) }))
  .filter((m) => m.u && m.img && yuzeyBul(m.yuzey));
// Anahtar: bütün parçaları çekilmiş yüzeyler, malzemeye göre gruplu; ızgara açılışta Brüt (yoksa Tuz)
const anahtar = yuzeyler.filter((y) => gorunen.every((u) => cekildi(u.slug, y.id)));
const varsayilan = anahtar.some((y) => y.id === 'brut') ? 'brut' : 'tuz';
const dizi = yuzeyler.filter((y) => cekildi(DIZI, y.id));
const kapaklar = { katedral: kapakFoto('katedral'), liman: kapakFoto('liman') };

// Her açıdan: yalnız beton ve çelik fotoğrafları
const DUVAR = [
  ['kemer', 'lansman', 'aci'], ['payanda', 'grafit', 'aci'], ['gul', 'lansman', 'ust'], ['sapel', 'tuz', 'aci'],
  ['keson', 'grafit', 'ust'], ['dalgakiran', 'lansman', 'aci'], ['demet', 'grafit', 'aci'], ['baba', 'lansman', 'aci'],
  ['silo', 'tuz', 'ust'], ['rihtim', 'lansman', 'aci'], ['antifer', 'grafit', 'aci'], ['sapel', 'lansman', 'ust'],
  ['payanda', 'lansman', 'ust'], ['kemer', 'grafit', 'ust'], ['gul', 'tuz', 'aci'], ['keson', 'lansman', 'aci'],
];
const duvar = DUVAR.filter(([s, y, c]) => fotoVar(s, y, c))
  .map(([s, y, c]) => ({ u: gorunen.find((x) => x.slug === s), y: yuzeyBul(y), c, f: foto(s, y, c) }))
  .filter((d) => d.u && d.y);

const kamp = ['katedral-genis', 'kemer-ayna', 'sapel-gece', 'payanda-masada', 'sapel-ayna', 'gul-ayna'].filter(kampanyaVar);
const kons = konseptler.filter((k) => konseptVar(k.gorsel));
const atolyeVar = Object.values(atolye).some(konseptVar);
---
<Base ana>
  <section class="kapak koyu" data-ton="koyu" aria-labelledby="kapak-bas">
    <h1 id="kapak-bas" class="kapak-baslik marka">
      <span class="satir"><span class="krom canli">Savana</span></span>
      <span class="satir"><span class="krom canli">Season</span></span>
    </h1>
    <div class="kapak-isik" aria-hidden="true"></div>
    <div
      class="donus kapak-urun"
      data-donus
      data-mod="oto"
      data-boy="b"
      data-kok={kapakYolu}
      data-kare={kapakVar ? KAPAK_KARE : KARE}
      role="img"
      aria-label="Kemer kitap desteği, kara çelik, kendi ekseninde dönüyor"
    >
      <img src={kapak.src} srcset={kapak.srcset} sizes="(min-width: 900px) 54svh, 86vw" width="1000" height="1250" alt="" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <p class="kose kose-su mono">Yalnız beton<br />Yalnız çelik</p>
    <p class="kose kose-sa mono">Katedral · Liman<br />Brütalist · Gotik · Endüstri</p>
    <a class="kose kose-alt-sol mono" href="#kampanya">Kampanya <span aria-hidden="true">↓</span></a>
    <p class="kose kose-alt-sag mono">Sürükle, döndür<br />Elde yapılır</p>
  </section>

  <Kayan />

  {kamp.length > 0 && (
    <section id="kampanya" class="kampanya koyu" data-ton="koyu" aria-labelledby="kampanya-bas">
      <div class="kap bas belir">
        <div>
          <p class="bolum-no">01 — Kampanya</p>
          <h2 id="kampanya-bas" class="baslik">Yalnız beton. Yalnız çelik. <span class="soluk">Başka bir şey yok.</span></h2>
        </div>
        <p class="bas-yan">Ham beton ve parlatılmış çelik; katedralin kemeri, limanın bloğu, fabrikanın kirişi.</p>
      </div>
      <div class="kap kamp-izgara">
        {kamp.map((ad, i) => {
          const g = kampanya(ad);
          return (
            <figure class:list={['kamp-kare foto', i === 0 && 'genis']}>
              <img src={g.src} srcset={g.srcset} sizes={i === 0 ? '(min-width: 900px) 92vw, 100vw' : '(min-width: 900px) 30vw, 50vw'} alt="Savana Season kampanya fotoğrafı, kara-beyaz" loading="lazy" decoding="async" />
            </figure>
          );
        })}
      </div>
    </section>
  )}

  <section id="koleksiyon" class="dukkan koyu" data-ton="koyu" data-dukkan data-taban={yol('')}>
    <div class="kap bas belir">
      <div>
        <p class="bolum-no">02 — Koleksiyon</p>
        <h2 class="baslik">Koleksiyon. <span class="soluk">Her parça betonda da çelikte de.</span></h2>
      </div>
      <div class="anahtar" role="group" aria-label="Bütün parçaları şu malzemede göster">
        <p class="ust">Malzeme <span class="anahtar-ad" aria-live="polite" data-anahtar-ad>{tamAd(yuzeyBul(varsayilan))}</span></p>
        <div class="anahtar-gruplar">
          {malzemeler.map((m) => {
            const ys = anahtar.filter((y) => y.malzeme === m.id);
            return ys.length > 0 && (
              <div class="anahtar-grup">
                <span class="mono soluk">{m.ad}</span>
                <div class="anahtar-liste">
                  {ys.map((y) => (
                    <button type="button" class="anahtar-dugme" data-yz={y.id} data-ad={tamAd(y)} aria-pressed={y.id === varsayilan ? 'true' : 'false'} aria-label={`${tamAd(y)}: ${y.kisa}`} title={tamAd(y)}>
                      <Ornek yuzey={y.id} />
                    </button>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    {koleksiyonlar.map((k, n) => {
      const liste = gorunen.filter((u) => u.koleksiyon === k.id);
      const kf = kapaklar[k.id];
      return (
        <div class="kol" id={k.id}>
          <figure class="kol-kapak foto">
            <img src={kf.src} srcset={kf.srcset} sizes="100vw" width="2400" height="1200" alt={`${k.ad} koleksiyonu, serim`} loading="lazy" decoding="async" />
            <figcaption class="kap kol-yazi">
              <span class="mono">0{n + 1} · {liste.length} parça</span>
              <h3 class="baslik">{k.ad}</h3>
              <p>{k.alt}</p>
            </figcaption>
          </figure>
          <ul class="izgara">
            {liste.map((u) => <UrunKart u={u} yuzey={varsayilan} />)}
          </ul>
        </div>
      );
    })}
  </section>

  {kons.length > 0 && (
    <section id="konsept" class="konsept koyu" data-ton="koyu" aria-labelledby="konsept-bas">
      <div class="kap bas belir">
        <div>
          <p class="bolum-no">03 — Konseptler</p>
          <h2 id="konsept-bas" class="baslik">Neler yapabiliriz. <span class="soluk">Fabrikadan ve katedralden fikirler.</span></h2>
        </div>
        <p class="bas-yan">Kiriş, somun, perçin, flanş, donatı. Endüstrinin parçaları gotik ayrıntıyla, yine tek malzemeden.</p>
      </div>
      <ul class="kap konsept-izgara">
        {kons.map((k, i) => {
          const g = konseptGorsel(k.gorsel);
          return (
            <li class="konsept-kart">
              <figure class="konsept-gorsel foto">
                <img src={g.src} srcset={g.srcset} sizes="(min-width: 1100px) 24vw, (min-width: 700px) 33vw, 50vw" width="1024" height="1280" alt={`${k.ad}: ${k.rol.toLocaleLowerCase('tr-TR')}, ${k.malzeme.toLocaleLowerCase('tr-TR')} konsept görseli`} loading="lazy" decoding="async" />
                <span class="mono konsept-etiket">Konsept {String(i + 1).padStart(2, '0')}</span>
              </figure>
              <div class="konsept-yazi">
                <h3 class="konsept-ad">{k.ad}</h3>
                <p class="mono soluk">{k.rol} · {k.malzeme}</p>
                <p class="soluk">{k.metin}</p>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="kap mono soluk not">Konsept görseller yapay zekâyla, kendi makinemizde üretildi; ürün henüz dökülmedi.</p>
    </section>
  )}

  <section id="galeri" class="galeri koyu" data-ton="koyu" aria-labelledby="galeri-bas">
    <div class="kap bas belir">
      <div>
        <p class="bolum-no">04 — Fotoğraflar</p>
        <h2 id="galeri-bas" class="baslik">Her açıdan. <span class="soluk">Yandan, üstten; betonda ve çelikte.</span></h2>
      </div>
      <p class="bas-yan">Beton parçalar traverten ve mermer üstünde, çelik parçalar ışığı yansıtırken.</p>
    </div>
    <ul class="kap duvar">
      {duvar.map((d) => (
        <li>
          <a class="duvar-kare foto" href={urunYolu(d.u.slug, cekildi(d.u.slug, d.y.id) ? d.y.id : 'tuz')}>
            <img src={d.f.src} srcset={d.f.srcset} sizes="(min-width: 1100px) 24vw, (min-width: 700px) 32vw, 50vw" width="1200" height="1500" alt={`${d.u.ad}, ${tamAd(d.y)}, ${cekimAdi[d.c].toLocaleLowerCase('tr-TR')}`} loading="lazy" decoding="async" />
            <span class="duvar-yazi">
              <strong>{d.u.ad}</strong>
              <span class="mono">{tamAd(d.y)} · {cekimAdi[d.c]}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {masada.length > 0 && (
    <section id="masada" class="masada koyu" data-ton="koyu" aria-labelledby="masada-bas">
      <div class="kap bas belir">
        <div>
          <p class="bolum-no">05 — Kullanım</p>
          <h2 id="masada-bas" class="baslik">Masada. <span class="soluk">Her parçanın bir işi var.</span></h2>
        </div>
        <div class="masada-yan">
          <p class="bas-yan">Şarabı tutar, mumu saklar, kitabı yaslar.</p>
          <div class="masada-ok">
            <button type="button" class="ok" data-yon="-1" aria-label="Önceki sahne">←</button>
            <button type="button" class="ok" data-yon="1" aria-label="Sonraki sahne">→</button>
          </div>
        </div>
      </div>
      <div class="masada-serit" data-serit tabindex="0" aria-label="Kullanım sahneleri">
        {masada.map((m, i) => (
          <a class="masada-kare" href={urunYolu(m.u.slug, cekildi(m.u.slug, m.yuzey) ? m.yuzey : 'tuz')} draggable="false">
            <div class="masada-gorsel">
              <Image src={m.img} widths={[420, 640, 900, 1200]} sizes="(min-width: 1200px) 30vw, (min-width: 760px) 42vw, 78vw" quality={76} alt={`${m.u.ad} ${m.u.rol.toLocaleLowerCase('tr-TR')} olarak kullanımda: ${m.sahne.toLocaleLowerCase('tr-TR')}`} loading="lazy" draggable="false" />
            </div>
            <div class="masada-yazi">
              <span class="mono soluk">№ {String(i + 1).padStart(2, '0')}</span>
              <strong>{m.u.ad}</strong>
              <span class="soluk">{m.u.rol} · {m.sahne} · {tamAd(yuzeyBul(m.yuzey))}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="kap masada-alt">
        <div class="ilerleme" aria-hidden="true"><span data-ilerleme></span></div>
      </div>
    </section>
  )}

  <section id="yuzeyler" class="yuzeyler koyu" data-ton="koyu" aria-labelledby="yz-bas">
    <div class="kap bas belir">
      <div>
        <p class="bolum-no">06 — Malzeme</p>
        <h2 id="yz-bas" class="baslik">Beton ya da çelik. <span class="soluk">Kalıp aynı, malzeme değişir.</span></h2>
      </div>
      <p class="bas-yan">Bir parça ya baştan sona betondur ya baştan sona çelik. Boya yok, karışım yok.</p>
    </div>
    <ol class="dizi" data-dizi style={`--sutun: ${dizi.length}`}>
      {dizi.map((y, i) => {
        const kok = donusKok(DIZI, y.id);
        const ilk = ilkKare(kok);
        return (
          <li class:list={['dizi-oge', i > 0 && dizi[i - 1].malzeme !== y.malzeme && 'yeni-grup']}>
            <div class="donus havuz" data-donus data-mod="dis" data-kok={kok} data-kare={KARE}>
              <img src={ilk.src} srcset={ilk.srcset} sizes="(min-width: 1000px) 18vw, 44vw" width="1000" height="1250" alt={`Şapel, ${tamAd(y)}`} loading="lazy" decoding="async" />
            </div>
            <div class="dizi-yazi">
              <span class="mono soluk">{y.malzeme === 'celik' ? 'Çelik' : 'Beton'}</span>
              <h3 class="dizi-ad">{y.ad}</h3>
              <p class="soluk">{y.kisa}</p>
            </div>
          </li>
        );
      })}
    </ol>
    <p class="kap mono soluk dizi-ipucu">Fareyi dizinin üstünde gezdir: hepsi birlikte döner.</p>
  </section>

  {atolyeVar && (
    <section id="atolye" class="atolye koyu" data-ton="koyu" aria-labelledby="atolye-bas">
      <div class="kap bas belir">
        <div>
          <p class="bolum-no">07 — Atölye</p>
          <h2 id="atolye-bas" class="baslik">Dökülür, kesilir, kazınır. <span class="soluk">Elde.</span></h2>
        </div>
        <p class="bas-yan">Beton silikon kalıba elde dökülür, derzleri harçla dolar. Çelik kesilir, kaynaklanır, çizgileri kazınır ve karartılır.</p>
      </div>
      <div class="kap atolye-izgara">
        {[['dokum', 'Döküm'], ['kesim', 'Kesim'], ['makro', 'Kazıma'], ['zincir', 'Çelik ve beton']].filter(([a]) => konseptVar(atolye[a])).map(([a, ad], i) => {
          const g = konseptGorsel(atolye[a]);
          return (
            <figure class:list={['atolye-kare foto', i === 0 && 'genis']}>
              <img src={g.src} srcset={g.srcset} sizes={i === 0 ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 30vw, 100vw'} alt={`${ad}, atölye görseli`} loading="lazy" decoding="async" />
              <figcaption class="mono">{ad}</figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  )}

  <section id="hikaye" class="hikaye koyu" data-ton="koyu" aria-labelledby="hikaye-bas">
    <div class="kap hikaye-ic">
      <p class="bolum-no">08 — Hikâye</p>
      <h2 id="hikaye-bas" class="baslik hikaye-baslik">Beton, çelik ve ışık.</h2>
      <div class="hikaye-metin">
        <p>Limanda her yapının bir işi var: dalgakıran dalgayı kırar, baba halatı tutar. Katedralde taş ışığa yol açar: kemer yükü taşır, payanda duvarı tutar. Fabrikada kiriş taşır, somun sıkar, perçin tutar.</p>
        <p>Savana Season bu yapıları masaya küçültüp onlara yeni bir iş veriyor. Malzemeye dokunmuyor: beton beton kalıyor, çelik çelik.</p>
        <p>Her parça elde yapılır. Beton dökülür ve derzleri harçla dolar; çelik kesilir, kazınır ve karartılır.</p>
      </div>
      {konseptVar(atolye.katedral) ? (
        <figure class="hikaye-gorsel">
          <img src={konseptGorsel(atolye.katedral).src} srcset={konseptGorsel(atolye.katedral).srcset} sizes="(min-width: 900px) 38vw, 100vw" alt="Brütalist beton katedral içi, sivri pencereden düşen ışık" loading="lazy" decoding="async" />
          <figcaption class="mono soluk">Beton katedral · konsept</figcaption>
        </figure>
      ) : masadaGorsel('sapel') && (
        <figure class="hikaye-gorsel">
          <Image src={masadaGorsel('sapel')} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 38vw, 100vw" quality={76} alt="Şapel mum feneri gece yanarken" loading="lazy" />
        </figure>
      )}
      <ul class="olgular mono">
        <li><Isaret />Yalnız beton</li>
        <li><Isaret />Yalnız çelik</li>
        <li><Isaret />Boya yok</li>
        <li><Isaret />Elde yapılır</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { donuslerKur, donusBul } from '../scripts/donus';

  donuslerKur();

  // Malzeme anahtarı: bütün kartları seçilen malzemeye çevirir
  const dukkan = document.querySelector<HTMLElement>('[data-dukkan]')!;
  const taban = dukkan.dataset.taban!;
  const adEl = dukkan.querySelector<HTMLElement>('[data-anahtar-ad]')!;
  const dugmeler = [...dukkan.querySelectorAll<HTMLButtonElement>('.anahtar-dugme')];
  dugmeler.forEach((d) =>
    d.addEventListener('click', () => {
      const yz = d.dataset.yz!;
      dugmeler.forEach((b) => b.setAttribute('aria-pressed', String(b === d)));
      adEl.textContent = d.dataset.ad!;
      dukkan.querySelectorAll<HTMLAnchorElement>('[data-kart]').forEach((a, i) => {
        const slug = a.dataset.slug!;
        a.href = `${taban}urun/${slug}/${yz === 'tuz' ? '' : `${yz}/`}`;
        const don = donusBul(a.querySelector('[data-donus]'));
        setTimeout(() => don?.kokDegistir(`${taban}donus/${slug}/${yz}/`), i * 35);
      });
    }),
  );

  // Malzeme dizisi: dönüşler birlikte; görünür olunca bir tur, fareyle gezdikçe döner
  const dizi = document.querySelector<HTMLElement>('[data-dizi]')!;
  const dizidekiler = [...dizi.querySelectorAll('[data-donus]')].map((e) => donusBul(e)!).filter(Boolean);
  const hepsiYuklensin = () => dizidekiler.forEach((d) => d.yukle());
  let turAtildi = false;
  new IntersectionObserver(
    ([g], gozcu) => {
      if (!g.isIntersecting) return;
      gozcu.disconnect();
      hepsiYuklensin();
      const bas = performance.now();
      const bekle = () => {
        const hazir = dizidekiler.every((d) => d.el.classList.contains('hazir'));
        if (hazir && !turAtildi && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          turAtildi = true;
          dizidekiler.forEach((d, i) => setTimeout(() => d.tween(d.i + d.kare, 2400), i * 70));
        } else if (!hazir && performance.now() - bas < 8000) setTimeout(bekle, 200);
      };
      bekle();
    },
    { threshold: 0.3 },
  ).observe(dizi);
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    dizi.addEventListener('pointerenter', hepsiYuklensin);
    dizi.addEventListener('pointermove', (e) => {
      const r = dizi.getBoundingClientRect();
      const oran = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      dizidekiler.forEach((d) => {
        d.tw = null;
        d.i = (oran - 0.5) * (d.kare - 1);
        d.ciz();
      });
    });
    dizi.addEventListener('pointerleave', () =>
      dizidekiler.forEach((d) => d.tween(Math.round(d.i / d.kare) * d.kare, 600)),
    );
  }

  // Masada şeridi: fareyle sürükle, oklarla geç, ilerleme çizgisi
  const serit = document.querySelector<HTMLElement>('[data-serit]');
  const ilerleme = document.querySelector<HTMLElement>('[data-ilerleme]');
  if (serit && ilerleme) {
    const guncelle = () => {
      const azami = serit.scrollWidth - serit.clientWidth;
      const oran = azami > 0 ? serit.scrollLeft / azami : 0;
      const gorunen = serit.clientWidth / serit.scrollWidth;
      ilerleme.style.width = `${Math.max(8, gorunen * 100)}%`;
      ilerleme.style.transform = `translateX(${oran * (1 / Math.max(gorunen, 0.08) - 1) * 100}%)`;
    };
    serit.addEventListener('scroll', guncelle, { passive: true });
    addEventListener('resize', guncelle);
    guncelle();
    const adim = () => (serit.querySelector<HTMLElement>('.masada-kare')?.offsetWidth ?? 300) + 16;
    document.querySelectorAll<HTMLButtonElement>('.masada-ok .ok').forEach((b) =>
      b.addEventListener('click', () => serit.scrollBy({ left: Number(b.dataset.yon) * adim(), behavior: 'smooth' })),
    );
    let surukle: { x: number; sol: number; oynadi: boolean } | null = null;
    serit.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      surukle = { x: e.clientX, sol: serit.scrollLeft, oynadi: false };
      serit.classList.add('cekiliyor');
    });
    addEventListener('pointermove', (e) => {
      if (!surukle) return;
      const dx = e.clientX - surukle.x;
      if (Math.abs(dx) > 5) surukle.oynadi = true;
      serit.scrollLeft = surukle.sol - dx;
    });
    addEventListener('pointerup', () => {
      if (!surukle) return;
      const oynadi = surukle.oynadi;
      surukle = null;
      serit.classList.remove('cekiliyor');
      if (oynadi) {
        const engelle = (ev: Event) => {
          ev.preventDefault();
          ev.stopPropagation();
        };
        serit.addEventListener('click', engelle, { capture: true, once: true });
        setTimeout(() => serit.removeEventListener('click', engelle, { capture: true }), 60);
      }
    });
  }
</script>

