---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import UrunKart from '../components/UrunKart.astro';
import Ornek from '../components/Ornek.astro';
import { urunler, koleksiyonlar } from '../data/urunler.js';
import { yuzeyler } from '../data/yuzeyler.js';
import { koleksiyonGorseli, urunGorseli, kullanimGorseli } from '../data/gorseller.js';
import { yol, urunYolu } from '../data/yol.js';

// Kapak: telefonda 5:4, genişte 2:1 (Katedral serimi, Grafit, kara mermer)
const darKapak = await getImage({ src: koleksiyonGorseli('kapak'), widths: [640, 960, 1280], format: 'webp', quality: 74 });
const genisKapak = await getImage({ src: koleksiyonGorseli('kapak-genis'), widths: [1280, 1920, 2560], format: 'webp', quality: 74 });
const hikayeGorseli = kullanimGorseli('sapel') ?? urunGorseli('keson', 'tuz', 'aci');
---
<Base>
  <section class="kapak">
    <div class="kap kapak-metin">
      <p class="ust-baslik">beton objeler</p>
      <h1 class="fraktur">Savana Season</h1>
      <p class="kapak-alt">Elde dökülen beton objeler. İki koleksiyon: Katedral ve Liman.</p>
      <div class="eylem">
        <a class="dugme" href="#koleksiyonlar">Koleksiyonlar</a>
        <a class="bag" href="#hikaye">Hikâye <span aria-hidden="true">›</span></a>
      </div>
    </div>
    <div class="kap kap-genis">
      <picture>
        <source media="(min-width: 700px)" srcset={genisKapak.srcSet.attribute} sizes="(min-width: 1440px) 1360px, 100vw" />
        <img
          class="kapak-gorsel kapak-iki"
          src={darKapak.src}
          srcset={darKapak.srcSet.attribute}
          sizes="100vw"
          width="1600"
          height="1280"
          alt="Katedral koleksiyonu Grafit yüzeyle kara mermer üzerinde: kemer çifti, şarap tutucu, mum feneri, vazo ve takı tabağı"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <div id="koleksiyonlar">
    {koleksiyonlar.map((k) => {
      const satista = urunler.filter((u) => u.koleksiyon === k.id && !u.yakinda);
      const yakinda = urunler.filter((u) => u.koleksiyon === k.id && u.yakinda);
      return (
        <section id={k.id} class="bolum">
          <div class="kap">
            <div class="bolum-bas">
              <p class="ust-baslik">Koleksiyon</p>
              <h2>{k.ad}</h2>
              <p>{k.alt}</p>
            </div>
            <div class="izgara">
              {satista.map((u) => <UrunKart u={u} />)}
            </div>
            {yakinda.map((u) => (
              <a class="yakinda" href={urunYolu(u.slug)}>
                <div class="yakinda-metin">
                  <span class="rozet">Yakında</span>
                  <h3>{u.ad}</h3>
                  <p class="yakinda-rol">{u.rol}</p>
                  <p>{u.metin}</p>
                  <span class="bag">İncele <span aria-hidden="true">›</span></span>
                </div>
                <Image
                  class="yakinda-gorsel"
                  src={kullanimGorseli(u.slug) ?? urunGorseli(u.slug, 'renk', 'aci')}
                  quality={74}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 900px) 36vw, 100vw"
                  alt={`${u.ad} masa lambası, gece yanarken`}
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <section id="yuzeyler" class="bolum yuzey-bolum">
    <div class="kap">
      <div class="bolum-bas">
        <p class="ust-baslik">Her parça için</p>
        <h2>Yedi yüzey</h2>
        <p>Kalıp aynı, yüzey değişir. Sıçramalar elde atılır; her parçada başka yere düşer.</p>
      </div>
      <div class="yz-sahne" data-yz-sahne>
        {yuzeyler.map((y, i) => (
          <Image
            class:list={['yz-gorsel', i === 0 && 'etkin']}
            src={koleksiyonGorseli(y.id)}
            quality={74}
            widths={[960, 1440, 2000]}
            sizes="(min-width: 1240px) 1180px, 100vw"
            alt={`Liman koleksiyonu, ${y.ad} yüzeyle`}
            loading="lazy"
            hidden={i !== 0}
            data-yz={y.id}
          />
        ))}
      </div>
      <div class="yz-secim" role="tablist" aria-label="Yüzey">
        {yuzeyler.map((y, i) => (
          <button
            type="button"
            role="tab"
            class="yz-dugme"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-yz={y.id}
            data-metin={y.metin}
          >
            <Ornek yuzey={y.id} />
            <span>{y.ad}</span>
          </button>
        ))}
      </div>
      <p class="yz-metin" aria-live="polite" data-yz-metin>{yuzeyler[0].metin}</p>
    </div>
  </section>

  <section id="hikaye" class="bolum hikaye">
    <div class="kap hikaye-ic">
      <div class="hikaye-metin">
        <p class="ust-baslik">Hikâye</p>
        <h2>Taş, iş ve ışık.</h2>
        <p>Limanda her yapının bir işi var: dalgakıran dalgayı kırar, baba halatı tutar. Katedralde taş ışığa yol açar: kemer yükü taşır, payanda duvarı tutar, gül pencere ışığı süzer.</p>
        <p>Savana Season bu yapıları masaya küçültüp onlara yeni bir iş veriyor. Payanda şarabı tutuyor, şapel mumu, kemer kitabı.</p>
        <p>Her parça beyaz çimentoyla elde dökülür. Yüzeydeki çizgiler kalıpta oluşur ve harçla tek tek doldurulur.</p>
      </div>
      <Image
        class="hikaye-gorsel kemer-maske"
        src={hikayeGorseli}
        quality={74}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 900px) 44vw, 100vw"
        alt="Şapel mum feneri gece yanarken: ışık sivri pencerelerden süzülüyor"
        loading="lazy"
      />
    </div>
  </section>

  <section id="nasil" class="bolum">
    <div class="kap">
      <div class="bolum-bas">
        <p class="ust-baslik">Sipariş</p>
        <h2>Üç adımda</h2>
      </div>
      <ol class="adimlar">
        <li><span class="adim-no">1</span><h3>Seç</h3><p>Parçayı ve yüzeyini seç.</p></li>
        <li><span class="adim-no">2</span><h3>Yaz</h3><p>Sipariş düğmesi mesajını hazırlar, sen gönderirsin.</p></li>
        <li><span class="adim-no">3</span><h3>Dökülür, gelir</h3><p>Parçan elde dökülür, kürünü alır ve kargoya verilir.</p></li>
      </ol>
      <p class="iade-not">
        Teslimden sonra 14 gün içinde iade edebilirsin; iade kargosu bizden.
        <a href={yol('siparis/')}>Sipariş ve iade <span aria-hidden="true">›</span></a>
      </p>
    </div>
  </section>
</Base>

<script>
  // Yedi yüzey: sekme seçimi koleksiyon görselini yumuşak geçişle değiştirir
  const sahne = document.querySelector<HTMLElement>('[data-yz-sahne]');
  const metin = document.querySelector<HTMLElement>('[data-yz-metin]');
  const dugmeler = [...document.querySelectorAll<HTMLButtonElement>('.yz-dugme')];
  let istenen = 0;
  const gorsel = (id: string) => sahne?.querySelector<HTMLImageElement>(`img[data-yz="${id}"]`);

  async function sec(i: number) {
    istenen = i;
    const d = dugmeler[i];
    dugmeler.forEach((b, j) => {
      b.setAttribute('aria-selected', String(j === i));
      b.tabIndex = j === i ? 0 : -1;
    });
    if (metin) metin.textContent = d.dataset.metin ?? '';
    const yeni = gorsel(d.dataset.yz ?? '');
    const eski = sahne?.querySelector<HTMLImageElement>('img.etkin');
    if (!yeni || yeni === eski) return;
    yeni.hidden = false;
    try { await yeni.decode(); } catch {}
    if (istenen !== i) return;
    sahne?.querySelectorAll('img.etkin').forEach((e) => e.classList.remove('etkin'));
    yeni.classList.add('etkin');
    setTimeout(() => {
      sahne?.querySelectorAll<HTMLImageElement>('img.yz-gorsel:not(.etkin)').forEach((e) => (e.hidden = true));
    }, 520);
  }

  dugmeler.forEach((d, i) => {
    d.addEventListener('click', () => sec(i));
    d.addEventListener('pointerenter', () => {
      const im = gorsel(d.dataset.yz ?? '');
      if (im) im.loading = 'eager';
    });
    d.addEventListener('keydown', (e) => {
      const yon = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!yon) return;
      e.preventDefault();
      const j = (i + yon + dugmeler.length) % dugmeler.length;
      dugmeler[j].focus();
      sec(j);
    });
  });
</script>
